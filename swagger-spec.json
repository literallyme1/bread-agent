  "info": {
    "title": "Bread API",
    "description": "Bread Reservation & Inventory API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateHoldDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "예약 사용자 ID"
          },
          "storeId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "예약 대상 매장 ID"
          },
          "pickupTime": {
            "type": "string",
            "description": "픽업 예정 시각 (ISO 8601). 현재 시각 이후여야 하며 매장 영업시간(open_time ~ close_time) 범위 내여야 합니다."
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "breadId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "빵 ID"
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "예약 수량 (1 이상)"
                }
              },
              "required": [
                "breadId",
                "qty"
              ]
            },
            "description": "예약할 빵 목록 (한 매장에서 여러 종류 동시 예약 가능)"
          }
        },
        "required": [
          "userId",
          "storeId",
          "pickupTime",
          "items"
        ]
      },
      "ConfirmHoldDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "예약 사용자 ID"
          },
          "holdToken": {
            "type": "string",
            "description": "hold 생성 시 발급된 토큰 (TTL 2분)"
          }
        },
        "required": [
          "userId",
          "holdToken"
        ]
      },
      "CancelReservationDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "취소 요청 사용자 ID (권한 검증)"
          }
        },
        "required": [
          "userId"
        ]
      },
      "PatchSessionDto": {
        "type": "object",
        "properties": {
          "preferred_station": {
