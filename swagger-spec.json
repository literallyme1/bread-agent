  "info": {
    "title": "Bread API",
    "description": "Bread Reservation & Inventory API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "PatchSessionDto": {
        "type": "object",
        "properties": {
          "last_store_id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "last_store_name": {
            "description": "마지막으로 선택한 매장 이름 (매장 선택 시점부터 저장)",
            "type": "string"
          },
          "selected_items": {
            "description": "아이템 목록 전체 교체. itemId와 동시 사용 불가. 각 요소: { id, name, count }",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "pickup_time": {
            "description": "픽업 예정 시각 (ISO 8601, 예: 2026-05-09T20:00:00)",
            "type": "string"
          },
          "hold_token": {
